    "@metis/skill-system": "workspace:*",
    "@xterm/addon-search": "^0.16.0",
    "better-sqlite3": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "^1.63.0",
