{
  "name": "metis-academy",
  "version": "1.0.0",
  "private": true,
  "description": "METIS Academy — 剧情驱动 + 项目模拟 + AI Agent 能力训练的桌面游戏",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @metis/desktop build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @metis/desktop test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:endings:count": "tsx scripts/count-endings.ts",
    "content:reachability": "tsx scripts/reachability.ts",
    "content:capability": "tsx scripts/capability-coverage.ts",
    "content:lint": "tsx scripts/content-lint.ts",
    "content:stats": "tsx scripts/validate-content.ts",
    "bot": "tsx scripts/bot.ts",
    "final-gate": "tsx scripts/final-gate.ts",
    "dist": "pnpm --filter @metis/desktop dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "better-sqlite3",
      "esbuild",
      "playwright-core"
    ]
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
